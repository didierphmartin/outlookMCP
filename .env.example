# Entra ID app (Entra ID → App registrations): "Accounts in any organizational directory and personal
# Microsoft accounts"; Authentication → Settings tab → "Allow public client flows" ON.
OUTLOOK_CLIENT_ID=
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it later means every mailbox must reconnect.
OUTLOOK_SECRET_KEY=
# Optional: enables the browser sign-in fallback. Must be reachable from the user's browser and be
# https://... (http:// only for localhost). Register <OUTLOOK_PUBLIC_URL>/auth/callback as a redirect URI
# (platform "Mobile and desktop applications" for a public client).
OUTLOOK_PUBLIC_URL=
# Only for a confidential registration; leave empty for a public client.
OUTLOOK_CLIENT_SECRET=
# 127.0.0.1 by default; 0.0.0.0 when a Docker edition of gpt reaches it via host.docker.internal.
OUTLOOK_HOST=127.0.0.1
OUTLOOK_PORT=8770
# Default ~/Documents/synergyAI/outlook_mcp.sqlite
OUTLOOK_DB_PATH=
# get_attachment size cap in bytes (default 10 MB)
OUTLOOK_ATTACHMENT_MAX_BYTES=10000000
# OUTLOOK_FAKE_GRAPH=1 runs against the built-in fake (no Microsoft account needed); OUTLOOK_FAKE_SEED=seed.json
