# Entra ID app: "Accounts in any organizational directory and personal Microsoft accounts", public client flows ON.
OUTLOOK_CLIENT_ID=
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OUTLOOK_SECRET_KEY=
# Optional: enables the browser sign-in fallback; must be https://... or http://localhost...
# Register <OUTLOOK_PUBLIC_URL>/auth/callback as a redirect URI (platform "Mobile and desktop" for a public client).
OUTLOOK_PUBLIC_URL=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_PORT=8770
# OUTLOOK_FAKE_GRAPH=1 runs against the built-in fake (no Microsoft account needed); OUTLOOK_FAKE_SEED=seed.json
