# Entra ID app (Entra ID → App registrations): "Accounts in any organizational directory and personal
# Microsoft accounts"; Authentication → Settings tab → "Allow public client flows" ON.
OUTLOOK_CLIENT_ID=
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it later means every mailbox must reconnect.
OUTLOOK_SECRET_KEY=
# Optional: enables the browser sign-in fallback. Must be reachable from the user's browser and be
# https://... (http:// only for localhost). Register <OUTLOOK_PUBLIC_URL>/auth/callback as a redirect URI
# (platform "Mobile and desktop applications" for a public client).
OUTLOOK_PUBLIC_URL=
# Only for a confidential registration; leave empty for a public client.
OUTLOOK_CLIENT_SECRET=
# 127.0.0.1 by default; 0.0.0.0 when a Docker edition of gpt reaches it via host.docker.internal.
OUTLOOK_HOST=127.0.0.1
OUTLOOK_PORT=8770
# Default ~/Documents/synergyAI/outlook_mcp.sqlite
OUTLOOK_DB_PATH=
# get_attachment size cap in bytes (default 10 MB)
OUTLOOK_ATTACHMENT_MAX_BYTES=10000000
# OUTLOOK_FAKE_GRAPH=1 runs against the built-in fake (no Microsoft account needed); OUTLOOK_FAKE_SEED=seed.json
# Events (optional): new mail wakes wait_for_new within about a minute instead of the next poll. Graph sends
# change notifications to an Azure Event Hub; this server reads the hub over an outbound connection (no public
# URL, no inbound port). Both empty = events off: wait_for_new is ready every WATCH_FALLBACK_S (timed polling).
# Listen-only policy of the hub (Event hub → Settings → Shared access policies), with EntityPath=<hub>.
EVENTHUB_CONNECTION=
# Where Graph sends them: EventHub:https://<namespace>.servicebus.windows.net/eventhubname/<hub>?tenantId=<tenant domain or id>
EVENTHUB_NOTIFICATION_URL=
EVENTHUB_CONSUMER_GROUP=$Default
# Safety poll: wait_for_new answers ready at least this often (seconds), to catch a lost notification.
WATCH_FALLBACK_S=900
